# ══════════════════════════════════════════════════════════════════════════════
# Capacity Connect — Environment Variable Reference
#
# Copy this file to .env and fill in real values before running locally.
#   cp .env.example .env
#
# ⚠️  NEVER commit .env to version control.
# ⚠️  All secrets marked CHANGE_ME must be replaced before production use.
# ══════════════════════════════════════════════════════════════════════════════


# ─── Application ──────────────────────────────────────────────────────────────

# Runtime environment. Affects logging, error verbosity, and security checks.
# Allowed: development | production | test
NODE_ENV=development

# The URL of the Next.js frontend. Used by:
#   • CORS policy in main.ts (credentials: true)
#   • Auth redirect URLs in emails (future)
# In production, set this to your actual domain (e.g. https://app.yourco.com)
FRONTEND_URL=http://localhost:3000


# ─── Demo Mode ────────────────────────────────────────────────────────────────

# Phase C-5 fix: Show quick-login demo buttons ONLY in dev/staging environments.
# Set to 'false' or leave unset in production to hide hardcoded credentials.
# Allowed: true | false
NEXT_PUBLIC_DEMO_MODE=true


# ─── API Server ───────────────────────────────────────────────────────────────

# Port the NestJS API listens on. Mapped by docker-compose as <PORT>:4000.
PORT=4000


# ─── Database (PostgreSQL) ────────────────────────────────────────────────────

# Full Prisma connection URL. Used directly by @prisma/client.
# Format: postgresql://<user>:<password>@<host>:<port>/<db>?schema=public
DATABASE_URL=postgresql://ccuser:ccpassword@localhost:5433/capacityconnect

# Individual variables used by the postgres Docker service in docker-compose.yml
POSTGRES_DB=capacityconnect
POSTGRES_USER=ccuser
POSTGRES_PASSWORD=ccpassword        # CHANGE_ME in production
POSTGRES_PORT=5433                  # mapped host port (container always uses 5432)


# ─── Cache (Redis) ────────────────────────────────────────────────────────────

# Redis connection URL. Used by ThrottlerModule for rate limiting.
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379


# ─── Object Storage (MinIO / S3) ──────────────────────────────────────────────

# Select the storage backend.
# Allowed: local | s3
# 'local' stores files in ./uploads/ (dev only). 's3' uses the S3_* vars below.
STORAGE_ADAPTER=local

# MinIO credentials (used by docker-compose dev service)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin      # CHANGE_ME in production
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# S3 / MinIO bucket settings (used when STORAGE_ADAPTER=s3)
S3_BUCKET=capacity-connect
S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:9000   # Point to your real S3 or MinIO endpoint
S3_ACCESS_KEY_ID=minioadmin         # CHANGE_ME in production
S3_SECRET_ACCESS_KEY=minioadmin     # CHANGE_ME in production


# ─── Authentication (JWT) ─────────────────────────────────────────────────────

# HMAC-SHA256 secret for signing access tokens (15 min lifetime).
# Generate with: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_USE_A_LONG_RANDOM_STRING_IN_PRODUCTION

# Access token lifetime. Prisma-compatible duration string.
JWT_EXPIRES_IN=15m

# Separate secret for refresh tokens (7 day lifetime, httpOnly cookie).
# Must be DIFFERENT from JWT_SECRET.
# Generate with: openssl rand -base64 64
JWT_REFRESH_SECRET=CHANGE_ME_ANOTHER_LONG_RANDOM_STRING

# Refresh token lifetime.
JWT_REFRESH_EXPIRES_IN=7d


# ─── Email (Nodemailer / SMTP) ────────────────────────────────────────────────

# In development, use Mailhog (docker-compose includes it as a dev dep):
#   SMTP_HOST=localhost  SMTP_PORT=1025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@capacityconnect.local


# ─── AI Provider ──────────────────────────────────────────────────────────────

# Pluggable AI backend for course drafting and skill gap explanations.
# Allowed: stub | openai | anthropic
# 'stub' returns deterministic mock responses — safe for offline / CI use.
AI_PROVIDER=stub

# Required if AI_PROVIDER=openai
OPENAI_API_KEY=

# Required if AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
